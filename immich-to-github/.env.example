# Immich Configuration
IMMICH_API_URL=https://your-immich-instance.com
IMMICH_API_KEY=your_immich_api_key_here

# Git push credentials
# Access token for the git remote in config.yaml's `git:` block (Gitea now,
# GitHub later). For Gitea: User Settings -> Applications -> Generate Token,
# with repo write scope.
GIT_PUSH_TOKEN=your_git_remote_access_token_here
